# Build output
*.apk
*.aab
*.app
*.unitypackage
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Meta writes a developer access token into this asset whenever the editor opens. Never commit it.
/Assets/Resources/DevAgentSettings.asset
/Assets/Resources/DevAgentSettings.asset.meta

# Meta XR regenerates these bindings for Play mode and builds.
/RuntimeActionBindings.json
/Assets/StreamingAssets/RuntimeActionBindings.json
/Assets/StreamingAssets/RuntimeActionBindings.json.meta

# Stray test and crash-recovery scenes
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta
/Assets/_Recovery/
/Assets/_Recovery.meta

# Local agent notes and tooling state
/.agents/local/
/.claude/
/.codex/

# Python
.venv/
venv/
__pycache__/
*.pyc
.env
.env.local

# Addressables / Localization build output (rebuilt with every player build)
/Assets/AddressableAssetsData/link.xml
/Assets/AddressableAssetsData/link.xml.meta
/Assets/AddressableAssetsData/*/*.bin*
/Assets/StreamingAssets/aa/
/Assets/StreamingAssets/aa.meta

# Python caches from Tools/
__pycache__/
*.pyc

# Found-moment sounds cut from Soundsnap downloads: the Soundsnap licence forbids sharing the raw files, so they stay
# out of this public repository (see README). BonVoyage_CabinChime (Pixabay) is included.
