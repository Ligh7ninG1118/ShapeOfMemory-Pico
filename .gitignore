# Meta writes a developer access token into this asset whenever the editor opens. Never commit it.
/Assets/Resources/DevAgentSettings.asset
/Assets/Resources/DevAgentSettings.asset.meta

# Meta XR regenerates these bindings for Play mode and builds.
/RuntimeActionBindings.json
/Assets/StreamingAssets/RuntimeActionBindings.json
/Assets/StreamingAssets/RuntimeActionBindings.json.meta

# Stray test and crash-recovery scenes
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta
/Assets/_Recovery/
/Assets/_Recovery.meta

