    RefIds:
    - rid: 714218833402396764
      type: {class: DistributedUIDGenerator, ns: UnityEngine.Localization.Tables, asm: Unity.Localization}
      data:
        m_CustomEpoch: 1794474446064
    - rid: 714218833402396770
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'English cover title, first big word: the cover reads top
          / of / bottom. An upright language (Chinese) prints ''title'' on one line
          instead, so its entry here is never shown.'
    - rid: 714218833402396771
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'English cover title, the small word between the two big ones
          (not shown in Chinese: see cover/title/top).'
    - rid: 714218833402396772
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'English cover title, second big word (not shown in Chinese:
          see cover/title/top).'
    - rid: 714218833402396773
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'The game''s name: the Chinese cover''s title (one line),
          and printed small under THANK YOU on the ending page.'
    - rid: 714218833402396774
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "Card above the closed book (eye tracking on). <em>\u2026</em>
          words print in the highlight colour."
    - rid: 714218833402396775
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Smaller second line of the cover card (eye tracking on).
    - rid: 714218833402396776
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "Card above the closed book (hands). <em>\u2026</em> prints
          in the highlight colour."
    - rid: 714218833402396777
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Smaller second line of the cover card (hands).
    - rid: 714218833402396778
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Card above the closed book (desktop, mouse).
    - rid: 714218833402396779
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Begin spread (the cover opens here), left page heading over
          the instructions.
    - rid: 714218833402396780
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Endpaper: first instruction heading.'
    - rid: 714218833402396781
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "Endpaper: how to turn a page (mouse). <em>\u2026</em> prints
          in the edge's colour."
    - rid: 714218833402396782
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "Endpaper: how to turn a page (hands). <em>\u2026</em> prints
          in the edge's colour."
    - rid: 714218833402396783
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Endpaper: second instruction heading.'
    - rid: 714218833402396784
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Endpaper: how to press (mouse).'
    - rid: 714218833402396785
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Endpaper: how to press (hands).'
    - rid: 714218833402396786
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Endpaper: third instruction heading.'
    - rid: 714218833402396787
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Endpaper: how to turn the objects (mouse).'
    - rid: 714218833402396788
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Endpaper: how to turn the objects (hands).'
    - rid: 714218833402396789
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Endpaper foot, only with eye tracking on.
    - rid: 714218833402396790
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Endpaper, right page, before any memory is found.
    - rid: 714218833402396791
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Endpaper, right page, once the book is finished.
    - rid: 714218833402396792
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Endpaper, right page, part way. {0} = memories found so far,
          {1} = memories in the book.
    - rid: 714218833402396793
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Endpaper, right page, the big line.
    - rid: 714218833402396794
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Tile under the table-height control.
    - rid: 714218833402396795
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Tile under the table-height control.
    - rid: 714218833402396796
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Between the LOWER and RAISE tiles; \n is a line break.
    - rid: 714218833402396797
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "Chapter heading. {0} = Roman numeral (I, II\u2026), {1} =
          Chinese numeral (\u4E00, \u4E8C\u2026), {2} = digit (1, 2\u2026)."
    - rid: 714218833402396798
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: A chapter's name while it is locked.
    - rid: 714218833402396799
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Under a chapter's plate once found.
    - rid: 714218833402396800
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Under a locked chapter's plate.
    - rid: 714218833402396801
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Under an open chapter's plate.
    - rid: 714218833402396802
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Right page of a locked chapter.
    - rid: 714218833402396803
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Right page of the next chapter, which starts by itself.
    - rid: 714218833402396804
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Tile on a found chapter.
    - rid: 714218833402396805
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Heading once a memory is found (on the walls, in the margin,
          on the found page).
    - rid: 714218833402396806
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: "First chapter only, on the dark page, until the player has
          turned the objects. <em>\u2026</em> prints in the highlight colour."
    - rid: 714218833402396807
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Dark wall page: label beside the small answer picture shown
          after the second hint.'
    - rid: 714218833402396808
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Paused memory, left page foot.
    - rid: 714218833402396809
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Found memory, right page foot.
    - rid: 714218833402396810
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Paused memory, right page heading.
    - rid: 714218833402396811
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Tile on the paused page.
    - rid: 714218833402396813
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Ending page before the book is finished.
    - rid: 714218833402396814
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Ending page, big word.
    - rid: 714218833402396815
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Ending page, small line under the big word.
    - rid: 714218833402396816
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: 'Credits: printed under a section heading that has no lines
          yet.'
    - rid: 714218833402396817
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Button on the post by the right hand during play.
    - rid: 714218833402396818
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Button on the post by the right hand during play.
    - rid: 714218833402396820
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: First chapter, beside the objects until they are turned (eye
          tracking on).
    - rid: 714218833402396821
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Smaller second line (eye tracking on).
    - rid: 714218833402396822
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: First chapter, beside the objects until they are turned (hands).
    - rid: 714218833402396823
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: First chapter, beside the objects until they are turned (mouse).
    - rid: 714218833402396824
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Smaller second line (hands and mouse).
    - rid: 714218833402396827
      type: {class: Comment, ns: UnityEngine.Localization.Metadata, asm: Unity.Localization}
      data:
        m_CommentText: Gold plaque over the objects at the moment of a solve.
