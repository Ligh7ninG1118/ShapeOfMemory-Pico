  m_Name: Birthday_NEW
  m_EditorClassIdentifier: ShadowWorkshop.Runtime::CloudGarden.ShadowPuzzle.Torch2Level
  title: H A P P Y   B I R T H D A Y
  button: ANOTHER YEAR
  riddle: 'Each year I wear a crown of flame

    while everyone sings out your name.

    One
    breath and all my lights are gone;

    now cut me up and pass me on.'
  hint: A two-tier birthday cake with candles on top, and a balloon floating to its
    right.
  complete: 'HAPPY BIRTHDAY

    Do we have enough candles?'
  accent: {r: 0.98, g: 0.62, b: 0.7, a: 1}
