  m_Name: GoodMorning_NEW
  m_EditorClassIdentifier: ShadowWorkshop.Runtime::CloudGarden.ShadowPuzzle.Torch2Level
  title: G O O D   M O R N I N G
  button: ORDER UP
  riddle: 'My hat stands tall but keeps off no rain;

    I stir and I taste, then
    I stir again.

    The pots are my soldiers, the stove is my throne,

    and
    no plate goes out till I''ve made it my own.'
  hint: A chef in a tall hat, seen side-on, looking to the left.
  complete: 'COMPLIMENTS TO THE CHEF

    Seconds, please!'
  accent: {r: 0.98, g: 0.55, b: 0.3, a: 1}
  lamps: 00000000
