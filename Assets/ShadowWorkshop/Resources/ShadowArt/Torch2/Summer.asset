  m_Script: {fileID: 11500000, guid: e73ae772b23bb7b4a8f302256c1471b3, type: 3}
  m_Name: Summer
  m_EditorClassIdentifier: ShadowWorkshop.Runtime::CloudGarden.ShadowPuzzle.Torch2Level
  title: S U M M E R T I M E
  button: SUMMERTIME
  riddle: 'On land I''m a lump that goes flop in the sun,

    but in water I''m
    swift, and the little fish run.

    I''ve whiskers and flippers; I clap and
    I bark,

    and I''ll balance your ball on my nose till it''s dark.'
  hint: 'A seal seen side-on: a round, whiskered head and a plump body tapering to
    its flippers.'
  complete: 'SEAL OF APPROVAL

    Just five more minutes in the sun!'
  accent: {r: 0.25, g: 0.66, b: 0.86, a: 1}
  lamps: 00000000
